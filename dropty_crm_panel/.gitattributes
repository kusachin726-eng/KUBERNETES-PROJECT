# Handle line endings automatically for text files
* text=auto

# Force LF (Linux) line endings for shell scripts and Docker files
# This is required for them to work inside the Alpine/Linux container
*.sh text eol=lf
Dockerfile* text eol=lf
*.template text eol=lf
.dockerignore text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
