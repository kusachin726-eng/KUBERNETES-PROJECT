user  nginx;
worker_processes auto;

error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    server_tokens off;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  30;
    types_hash_max_size 2048;

    # Gzip compression
    gzip on;
    gzip_disable "msie6";
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length  256;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # Global rate limiting & connection limiting (values set at runtime via env vars)
    limit_req_zone $binary_remote_addr zone=req_zone:10m rate=${RATE_LIMIT_RATE};
    limit_conn_zone $binary_remote_addr zone=addr:10m;

    # Map 429 status to a flag for conditional logging
    map $status $is_limited {
        429 1;
        default 0;
    }

    # Log format for rate-limited requests (includes forwarded and possible user headers)
    log_format rate_limited '$remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent "$http_referer" "$http_user_agent" "$http_x_forwarded_for" "$upstream_addr" "$upstream_http_x_user_id"';

    access_log /var/log/nginx/access.log;
    access_log /var/log/nginx/rate_limited.log rate_limited if=$is_limited;

    upstream backend {
        server ${UPSTREAM_HOST}:${UPSTREAM_PORT};
        keepalive 32;
    }

    server {
        listen 80;
        server_name _;

        # NGINX metrics
        location /nginx_status {
            stub_status on;
            allow 127.0.0.1;
            deny all;
        }

        # Lightweight liveness probe handled by nginx (no backend hit)
        location = /health {
            default_type text/plain;
            return 200 'OK';
        }

        # Readiness - proxy to backend health endpoint to verify app readiness
        location = /ready {
            proxy_pass http://backend/health;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location / {
            proxy_pass http://backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-User-Id $http_x_user_id;


            proxy_connect_timeout 5s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
            send_timeout 30s;

            limit_req zone=req_zone burst=${RATE_LIMIT_BURST} nodelay;
            limit_conn addr ${RATE_LIMIT_CONN};
        }

        error_page 429 = @too_many;
        location @too_many {
            add_header Retry-After 60;
            return 429 'Too Many Requests';
        }

        client_max_body_size ${CLIENT_MAX_BODY_SIZE};
    }
}
