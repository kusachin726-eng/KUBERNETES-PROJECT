# Runtime environment template - minimal set requested by user
NODE_ENV=
APP_PORT=

# PostgresStaging
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSL=

# JWT
JWT_EXPIRES_IN=d7
JWT_SECRET=please_change_me

# Rate limiting (optional; defaults applied by entrypoint if not provided)
# Example RATE_LIMIT_RATE value: "5r/s" or "100r/m"
RATE_LIMIT_RATE=5r/s
RATE_LIMIT_BURST=10
RATE_LIMIT_CONN=20
RATE_LIMIT_ENABLED=1

# NGINX / app settings
CLIENT_MAX_BODY_SIZE=10M
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=3005

# Azure Blob Storage (future use)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_ACCESS_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
AZURE_BLOB_ENDPOINT=

# Add additional keys below as needed
