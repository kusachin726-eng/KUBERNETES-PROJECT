<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            background: #f5f5f5;
        }
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 40px 20px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        .header {
            text-align: center;
            border-bottom: 3px solid #0066cc;
            padding-bottom: 30px;
            margin-bottom: 40px;
        }
        .header h1 {
            color: #0066cc;
            margin: 0 0 10px 0;
            font-size: 36px;
        }
        .header p {
            color: #666;
            font-size: 16px;
        }
        .last-updated {
            color: #999;
            font-size: 13px;
            margin-top: 15px;
        }
        .categories {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }
        .category-card {
            background: linear-gradient(135deg, #0066cc 0%, #0099ff 100%);
            color: white;
            padding: 25px;
            border-radius: 8px;
            cursor: pointer;
            text-align: center;
            transition: transform 0.3s, box-shadow 0.3s;
        }
        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0, 102, 204, 0.3);
        }
        .category-card .icon {
            font-size: 32px;
            margin-bottom: 10px;
        }
        .category-card h3 {
            margin: 0;
            font-size: 18px;
        }
        .faq-section {
            margin-bottom: 50px;
            border-left: 4px solid #0066cc;
            padding-left: 20px;
        }
        .faq-section h2 {
            color: #0066cc;
            font-size: 28px;
            margin: 0 0 20px 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .faq-item {
            margin-bottom: 20px;
            border-radius: 5px;
            overflow: hidden;
            box-shadow: 0 2px 5px rgba(0,0,0,0.08);
        }
        .faq-question {
            background: #f9f9f9;
            padding: 18px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: background 0.3s;
            border-left: 4px solid #0099ff;
            font-weight: 600;
            color: #0066cc;
        }
        .faq-question:hover {
            background: #f0f0f0;
        }
        .faq-toggle {
            font-size: 20px;
            transition: transform 0.3s;
        }
        .faq-answer {
            background: white;
            padding: 0 18px;
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease, padding 0.3s ease;
            color: #555;
            line-height: 1.8;
        }
        .faq-answer.active {
            max-height: 500px;
            padding: 18px;
        }
        .faq-toggle.active {
            transform: rotate(180deg);
        }
        @media (max-width: 768px) {
            .container {
                padding: 20px 15px;
            }
            .header h1 {
                font-size: 26px;
            }
            .categories {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>❓ Frequently Asked Questions</h1>
            <p>Find answers to common questions about Dropty flights</p>
            <p class="last-updated">Last Updated: <%= faq.lastUpdated %></p>
        </div>

        <div class="categories">
            <% faq.categories.forEach(cat => { %>
                <div class="category-card" onclick="scrollToCategory('<%= cat.id %>')">
                    <div class="icon"><%= cat.icon %></div>
                    <h3><%= cat.title %></h3>
                </div>
            <% }); %>
        </div>

        <% faq.categories.forEach(category => { %>
            <div class="faq-section" id="<%= category.id %>">
                <h2><span><%= category.icon %></span><%= category.title %></h2>
                
                <% category.faqs.forEach((item, index) => { %>
                    <div class="faq-item">
                        <div class="faq-question" onclick="toggleAnswer(this)">
                            <span><%= item.question %></span>
                            <span class="faq-toggle">▼</span>
                        </div>
                        <div class="faq-answer">
                            <p><%= item.answer %></p>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% }); %>
    </div>

    <script>
        function toggleAnswer(element) {
            const answer = element.nextElementSibling;
            const toggle = element.querySelector('.faq-toggle');
            
            answer.classList.toggle('active');
            toggle.classList.toggle('active');
        }

        function scrollToCategory(categoryId) {
            const element = document.getElementById(categoryId);
            if (element) {
                element.scrollIntoView({ behavior: 'smooth' });
            }
        }
    </script>
</body>
</html>